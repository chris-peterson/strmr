{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Streaming subscription ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "periods"],
  "properties": {
    "version": {
      "const": 1
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/period"
      }
    },
    "viewing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "date", "title"],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "date": {
            "$ref": "#/definitions/date"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "service", "start", "end", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "start": {
          "$ref": "#/definitions/date"
        },
        "end": {
          "description": "First uncovered day, or null for ongoing coverage.",
          "anyOf": [
            {
              "$ref": "#/definitions/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": ["export", "billing", "manual"]
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimate": {
          "$ref": "#/definitions/estimate"
        },
        "chargedOn": {
          "$ref": "#/definitions/date"
        },
        "taxMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subtotalMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "dependencies": {
        "amountMinor": ["currency"],
        "currency": ["amountMinor"],
        "estimate": ["amountMinor", "currency"],
        "taxMinor": ["amountMinor", "subtotalMinor"],
        "subtotalMinor": ["amountMinor", "taxMinor"]
      }
    },
    "estimate": {
      "description": "One billing cycle inferred from a historical MapSub list price observed on the charge date.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "mapsub"
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "cycle": {
          "enum": ["monthly", "annual"]
        },
        "firstSeen": {
          "$ref": "#/definitions/date"
        },
        "lastSeen": {
          "$ref": "#/definitions/date"
        },
        "evidenceUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "basis",
        "plan",
        "cycle",
        "firstSeen",
        "lastSeen",
        "evidenceUrl"
      ]
    }
  }
}
